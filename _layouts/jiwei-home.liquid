---
layout: jiwei-base
---
{%- assign h = site.data.jiwei_home -%}
{%- assign zh = h.zh -%}
{%- assign i18n = site.data.jiwei_i18n -%}
{%- assign selected = site.data.jiwei_publications.papers | where: 'selected', true -%}
      <section class="hero" id="intro" aria-labelledby="hero-name">
        <div class="hero-copy">
          <p class="eyebrow" data-en="{{ i18n.eyebrow.en | escape }}" data-zh="{{ i18n.eyebrow.zh | escape }}">{{ i18n.eyebrow.en }}</p>
          <h1 id="hero-name"><span class="first-name">{{ h.first_name | escape }}</span><span class="surname-line"><em>{{ h.last_name | escape }}</em><span class="chinese-name" lang="zh-Hans">{{ h.chinese_name | escape }}</span></span></h1>
          <p class="position" data-en="{{ h.role | escape }}" data-zh="{{ zh.role | escape }}">{{ h.role | escape }}<br><span data-en="{{ h.department | escape }}, {{ h.university | escape }}" data-zh="{{ zh.department | escape }}，{{ zh.university | escape }}">{{ h.department | escape }}, {{ h.university | escape }}</span></p>
          <p class="hero-intro" data-en="{{ h.intro | escape }}" data-zh="{{ zh.intro | escape }}">{{ h.intro | escape }}</p>
          <div class="hero-actions">
            <a class="primary-link" href="#research"><span data-en="{{ i18n.explore_research.en | escape }}" data-zh="{{ i18n.explore_research.zh | escape }}">{{ i18n.explore_research.en }}</span></a>
            <a class="primary-link" href="#contact"><span data-en="{{ i18n.get_in_touch.en | escape }}" data-zh="{{ i18n.get_in_touch.zh | escape }}">{{ i18n.get_in_touch.en }}</span></a>
          </div>
        </div>
        <figure class="portrait-wrap">
          <img class="portrait" src="{{ h.portrait | relative_url }}" width="1280" height="1920" alt="Portrait of Jiwei Sun" fetchpriority="high">
        </figure>
      </section>

      <section class="section about-section" id="about" aria-labelledby="about-title">
        <div class="section-heading"><h2 id="about-title"><span class="heading-number">01 /</span> <span data-en="{{ i18n.heading_about.en | escape }}" data-zh="{{ i18n.heading_about.zh | escape }}">{{ i18n.heading_about.en }}</span></h2></div>
        <div class="section-copy">
          {%- for paragraph in h.about %}
            {%- assign zh_paragraph = zh.about[forloop.index0] %}
            <p data-en="{{ paragraph | escape }}" data-zh="{{ zh_paragraph | escape }}">{{ paragraph | escape }}</p>
          {%- endfor %}
          <a class="text-link" href="#education"><span data-en="{{ i18n.my_background.en | escape }}" data-zh="{{ i18n.my_background.zh | escape }}">{{ i18n.my_background.en }}</span></a>
        </div>
      </section>

      <section class="section research-section" id="research" aria-labelledby="research-title">
        <div class="section-top"><div><h2 id="research-title"><span class="heading-number">02 /</span> <span data-en="{{ i18n.heading_research.en | escape }}" data-zh="{{ i18n.heading_research.zh | escape }}">{{ i18n.heading_research.en }}</span></h2></div></div>
        <div class="research-grid">
          {%- for topic in h.research %}
            {%- assign zh_topic = zh.research[forloop.index0] %}
            <article class="research-item"><span class="topic-index" aria-hidden="true">{{ forloop.index }}</span><div><h3 data-en="{{ topic.title | escape }}" data-zh="{{ zh_topic.title | escape }}">{{ topic.title | escape }}</h3><p data-en="{{ topic.text | escape }}" data-zh="{{ zh_topic.text | escape }}">{{ topic.text | escape }}</p></div></article>
          {%- endfor %}
        </div>
        <div class="methods"><div><h3 data-en="{{ i18n.heading_methods.en | escape }}" data-zh="{{ i18n.heading_methods.zh | escape }}">{{ i18n.heading_methods.en }}</h3><p class="software">{{ h.software | escape }}</p></div><ul>{%- for method in h.methods %}{%- assign zh_method = zh.methods[forloop.index0] %}<li data-en="{{ method | escape }}" data-zh="{{ zh_method | escape }}">{{ method | escape }}</li>{%- endfor %}</ul></div>
      </section>

      <section class="section publications-section" id="publications" aria-labelledby="publications-title">
        <div class="section-top"><div><h2 id="publications-title"><span class="heading-number">03 /</span> <span data-en="{{ i18n.heading_publications.en | escape }}" data-zh="{{ i18n.heading_publications.zh | escape }}">{{ i18n.heading_publications.en }}</span></h2></div><a class="text-link" href="{{ '/publications/' | relative_url }}"><span data-en="{{ i18n.all_publications.en | escape }}" data-zh="{{ i18n.all_publications.zh | escape }}">{{ i18n.all_publications.en }}</span></a></div>
        <div class="publication-list">
        {%- for paper in selected %}
          {%- assign journal = site.data.jiwei_journal_metrics[paper.journal] %}
          {%- assign doi_key = paper.doi | remove: 'https://doi.org/' | downcase %}
          {%- assign citation = site.data.jiwei_citations[doi_key] %}
          <article class="publication" aria-labelledby="paper-title-{{ forloop.index }}">
            {%- if journal.cover %}<a class="journal-cover" href="{{ journal.source | escape }}" aria-label="{{ paper.journal | escape }} journal information"><img src="{{ journal.cover | relative_url }}" width="595" height="782" alt="{{ journal.cover_alt | escape }}" loading="lazy"></a>{% endif %}
            <div class="paper-detail">
              <div class="paper-meta"><span class="paper-year">{{ paper.year }}</span><p class="journal-label">{{ paper.journal | escape }}</p></div>
              <h3 id="paper-title-{{ forloop.index }}"><a href="{{ paper.doi | escape }}">{{ paper.title | escape }}</a></h3>
              <p class="paper-authors">{% include jiwei_authors.liquid paper=paper marks=true %}</p>
              <p class="paper-citation"><em>{{ paper.journal | escape }}{% if paper.volume %}, {{ paper.volume | escape }}{% endif %}</em>{% if paper.issue %}({{ paper.issue | escape }}){% endif %}{% if paper.pages %}, {{ paper.pages | escape }}{% endif %}.</p>
              <div class="paper-footer">
                <div class="paper-links">
                  <a href="{{ paper.doi | escape }}"><span data-en="{{ i18n.read_article.en | escape }}" data-zh="{{ i18n.read_article.zh | escape }}">{{ i18n.read_article.en }}</span></a>
                  {%- if paper.pdf %}<a href="{{ paper.pdf | escape }}"><span data-en="{{ i18n.publisher_pdf.en | escape }}" data-zh="{{ i18n.publisher_pdf.zh | escape }}">{{ i18n.publisher_pdf.en }}</span></a>{% endif %}
                </div>
                <div class="paper-metrics" aria-label="Journal and article metrics">
                  {%- if journal.impact_factor %}<a class="metric-badge" href="{{ journal.source | escape }}" title="Journal Impact Factor, {{ journal.year }}"><span>IF</span> <strong>{{ journal.impact_factor }}</strong><small>{{ journal.year }}</small></a>{% endif %}
                  {%- if journal.quartile %}<a class="metric-badge" href="{{ journal.quartile_source | escape }}" title="{{ journal.category | escape }} — {{ journal.year }} JCR quartile"><span>{{ journal.index | escape }}</span> <strong>{{ journal.quartile | escape }}</strong><small>{{ journal.year }}</small></a>{% endif %}
                  <span class="metric-badge citation-metric" data-doi="{{ doi_key | escape }}" data-count="{{ citation.count }}" data-checked="{{ citation.retrieved_at | escape }}" title="Crossref cited-by count"><span>Citations</span> <strong data-citation-count>{% if citation.count != nil %}{{ citation.count }}{% else %}—{% endif %}</strong><small>Crossref</small></span>
                </div>
              </div>
            </div>
          </article>
        {%- endfor %}
        </div>
      </section>

      <section class="section education-section" id="education" aria-labelledby="education-title">
        <div class="section-heading"><h2 id="education-title"><span class="heading-number">04 /</span> <span data-en="{{ i18n.heading_education.en | escape }}" data-zh="{{ i18n.heading_education.zh | escape }}">{{ i18n.heading_education.en }}</span></h2></div>
        {%- assign work_count = 0 %}
        {%- for entry in h.timeline %}{% if entry.kind == 'work' %}{% assign work_count = work_count | plus: 1 %}{% endif %}{% endfor %}
        {%- assign work_used = work_count | times: 2 %}{%- assign work_gap = 6 | minus: work_used | divided_by: 2 | plus: 1 %}
        {%- assign work_index = 0 %}
        <ol class="edu-timeline">
          {%- for entry in h.timeline %}
            {%- assign zh_entry = zh.timeline[forloop.index0] %}
            {%- if entry.kind == 'work' %}
              {%- assign work_column = work_index | times: 2 | plus: work_gap %}
              {%- assign work_index = work_index | plus: 1 %}
            {%- endif %}
            <li class="timeline-item timeline-item--{{ entry.kind | escape }}"{% if entry.kind == 'work' %} style="grid-column: {{ work_column }} / span 2"{% endif %}>
              <div class="timeline-card">
                <div class="timeline-meta">
                  <span class="timeline-label" data-en="{{ entry.label | escape }}" data-zh="{{ zh_entry.label | default: entry.label | escape }}">{{ entry.label | escape }}</span>
                </div>
                <h3 data-en="{{ entry.title | escape }}" data-zh="{{ zh_entry.title | default: entry.title | escape }}">{{ entry.title | escape }}</h3>
                {%- if entry.role %}
                  <p class="timeline-role" data-en="{{ entry.role | escape }}" data-zh="{{ zh_entry.role | default: entry.role | escape }}">{{ entry.role | escape }}</p>
                {%- endif %}
                {%- if entry.detail %}
                  <p class="timeline-detail" data-en="{{ entry.detail | escape }}" data-zh="{{ zh_entry.detail | default: entry.detail | escape }}">{{ entry.detail | escape }}</p>
                {%- endif %}
                {%- if entry.note and entry.note != '' %}
                  <span class="timeline-note" data-en="{{ entry.note | escape }}" data-zh="{{ zh_entry.note | default: entry.note | escape }}">{{ entry.note | escape }}</span>
                {%- endif %}
                {%- if entry.supervisor and entry.supervisor != '' %}
                  <span class="timeline-supervisor" data-en="{{ entry.supervisor | escape }}" data-zh="{{ zh_entry.supervisor | default: entry.supervisor | escape }}">{{ entry.supervisor | escape }}</span>
                {%- endif %}
                <div class="timeline-footer">
                  {%- for tag in entry.tags %}
                    {%- assign zh_tag = zh_entry.tags[forloop.index0] %}
                    <span class="timeline-badge" data-en="{{ tag | escape }}" data-zh="{{ zh_tag | default: tag | escape }}">{{ tag | escape }}</span>
                  {%- endfor %}
                  {%- if entry.period %}
                    <span class="timeline-period-tag" data-en="{{ entry.period | escape }}" data-zh="{{ zh_entry.period | default: entry.period | escape }}">{{ entry.period | escape }}</span>
                  {%- endif %}
                </div>
              </div>
            </li>
          {%- endfor %}
        </ol>
      </section>

      <section class="section contact-section" id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title"><span class="heading-number">05 /</span> <span data-en="{{ i18n.heading_contact.en | escape }}" data-zh="{{ i18n.heading_contact.zh | escape }}">{{ i18n.heading_contact.en }}</span></h2>
        <div class="contact-actions">
          <a class="primary-link email-link" href="mailto:{{ h.email | escape }}">{{ h.email | escape }} <span aria-hidden="true">↗</span></a>
          <details class="wechat-contact">
            <summary class="primary-link">WeChat <span aria-hidden="true">↗</span></summary>
            <div class="wechat-card">
              <p class="wechat-id">JasonSunedu</p>
              <img src="{{ '/assets/img/wechat-qr.svg' | relative_url }}" width="245" height="245" alt="WeChat QR code for JasonSunedu" loading="lazy">
            </div>
          </details>
        </div>
        <div class="contact-links"><a href="{{ h.scholar | escape }}">Google Scholar</a><a href="{{ h.orcid | escape }}">ORCID</a><a href="{{ h.researchgate | escape }}">ResearchGate</a></div>
      </section>
      {{ content }}
