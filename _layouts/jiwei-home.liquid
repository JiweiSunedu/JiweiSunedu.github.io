<!doctype html>
{% assign h = site.data.jiwei_home %}
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ h.name | escape }} | Education &amp; Computational Thinking</title>
    <meta name="description" content="{{ h.description | escape }}">
    <meta name="theme-color" content="#fff5eb">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ h.name | escape }} | Education Researcher">
    <meta property="og:description" content="{{ h.description | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ h.portrait | absolute_url }}">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23a54b18'/%3E%3Ctext x='32' y='43' text-anchor='middle' fill='white' font-family='Georgia' font-size='34'%3EJS%3C/text%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/assets/css/jiwei-home.css' | relative_url }}">
    <script src="{{ '/assets/js/jiwei-home.js' | relative_url }}" defer></script>
    <script src="{{ '/assets/js/jiwei-citations.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="wordmark" href="#intro" aria-label="Jiwei Sun, back to introduction">JS<span class="wordmark-dot">.</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">Menu <span aria-hidden="true">☰</span></button>
        <nav class="main-navigation" id="main-navigation" aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#research">Research</a>
          <a href="#publications">Publications</a>
          <a href="#education">Education</a>
          <a href="#contact">Contact</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false" title="Change color theme"><span aria-hidden="true">◐</span></button>
      </div>
    </header>

    <main id="main" class="page-wrap">
      <section class="hero" id="intro" aria-labelledby="hero-name">
        <div class="hero-copy">
          <p class="eyebrow">Education · Computational thinking</p>
          <h1 id="hero-name"><span class="first-name">{{ h.first_name | escape }}</span><span class="surname-line"><em>{{ h.last_name | escape }}</em><span class="chinese-name" lang="zh-Hans">{{ h.chinese_name | escape }}</span></span></h1>
          <p class="position">{{ h.role | escape }}<br><span>{{ h.department | escape }}, {{ h.university | escape }}</span></p>
          <p class="hero-intro">{{ h.intro | escape }}</p>
          <div class="hero-actions">
            <a class="primary-link" href="#research">Explore my research <span aria-hidden="true">↗</span></a>
            <a class="primary-link" href="#contact">Get in touch <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <figure class="portrait-wrap">
          <img class="portrait" src="{{ h.portrait | relative_url }}" width="1280" height="1920" alt="Portrait of Jiwei Sun" fetchpriority="high">
        </figure>
      </section>

      <section class="section about-section" id="about" aria-labelledby="about-title">
        <div class="section-heading"><h2 id="about-title"><span class="heading-number">01 /</span> About Me</h2></div>
        <div class="section-copy">{% for paragraph in h.about %}<p>{{ paragraph | escape }}</p>{% endfor %}<a class="text-link" href="#education">My academic background <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="section research-section" id="research" aria-labelledby="research-title">
        <div class="section-top"><div><h2 id="research-title"><span class="heading-number">02 /</span> Research Interest</h2></div></div>
        <div class="research-grid">{% for topic in h.research %}<article class="research-item"><span class="topic-index" aria-hidden="true">0{{ forloop.index }}</span><div><h3>{{ topic.title | escape }}</h3><p>{{ topic.text | escape }}</p></div></article>{% endfor %}</div>
        <div class="methods"><div><h3>Methods &amp; tools</h3><p class="software">{{ h.software | escape }}</p></div><ul>{% for method in h.methods %}<li>{{ method | escape }}</li>{% endfor %}</ul></div>
      </section>

      <section class="section publications-section" id="publications" aria-labelledby="publications-title">
        <div class="section-top"><div><h2 id="publications-title"><span class="heading-number">03 /</span> Selected Publications</h2></div><a class="text-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a></div>
        <div class="publication-list">
        {% for paper in h.publications %}
          {% assign journal = site.data.jiwei_journal_metrics[paper.journal] %}
          {% assign doi_key = paper.doi | remove: 'https://doi.org/' | downcase %}
          {% assign citation = site.data.jiwei_citations[doi_key] %}
          <article class="publication" aria-labelledby="paper-title-{{ forloop.index }}">
            {% if journal.cover %}<a class="journal-cover" href="{{ journal.source | escape }}" aria-label="{{ paper.journal | escape }} journal information"><img src="{{ journal.cover | relative_url }}" width="595" height="782" alt="{{ journal.cover_alt | escape }}" loading="lazy"></a>{% endif %}
            <div class="paper-detail">
              <div class="paper-meta"><span class="paper-year">{{ paper.year }}</span><p class="journal-label">{{ paper.journal | escape }}</p></div>
              <h3 id="paper-title-{{ forloop.index }}"><a href="{{ paper.doi | escape }}">{{ paper.title | escape }}</a></h3>
              <p class="paper-authors">{{ paper.authors | escape }}</p>
              <p class="paper-citation"><em>{{ paper.journal | escape }}, {{ paper.volume | escape }}</em>({{ paper.issue | escape }}), {{ paper.article | escape }}.</p>
              <div class="paper-links"><a href="{{ paper.doi | escape }}">Read article <span aria-hidden="true">↗</span></a>{% if paper.pdf %}<a href="{{ paper.pdf | escape }}">Publisher PDF <span aria-hidden="true">↗</span></a>{% endif %}</div>
              <div class="paper-metrics" aria-label="Journal and article metrics">
                {% if journal.impact_factor %}<a class="metric-badge" href="{{ journal.source | escape }}" title="Journal Impact Factor, {{ journal.year }}"><span>IF</span> <strong>{{ journal.impact_factor }}</strong><small>{{ journal.year }}</small></a>{% endif %}
                {% if journal.quartile %}<a class="metric-badge" href="{{ journal.quartile_source | escape }}" title="{{ journal.category | escape }} — {{ journal.year }} JCR quartile"><span>{{ journal.index | escape }}</span> <strong>{{ journal.quartile | escape }}</strong><small>{{ journal.year }}</small></a>{% endif %}
                <span class="metric-badge citation-metric" data-doi="{{ doi_key | escape }}" data-count="{{ citation.count }}" data-checked="{{ citation.retrieved_at | escape }}"><span>Citations</span> <strong data-citation-count>{% if citation.count != nil %}{{ citation.count }}{% else %}—{% endif %}</strong><small>Crossref</small></span>
              </div>
              <div class="metric-notes"><span data-citation-status-for="{{ doi_key | escape }}">{% if citation.retrieved_at %}Citations checked {{ citation.retrieved_at | slice: 0, 10 }}{% else %}Citation count not available{% endif %}</span>
                {% if journal.source %}<details class="metric-sources"><summary>Journal metric details</summary><p>{{ journal.category | escape }} · {{ journal.year }} metrics.<br>Verified {{ journal.verified_on | escape }}. <a href="{{ journal.source | escape }}">Impact factor</a> · <a href="{{ journal.quartile_source | escape }}">Quartile</a> · <a href="{{ journal.index_source | escape }}">Indexing</a></p></details>{% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
        </div>
      </section>

      <section class="section education-section" id="education" aria-labelledby="education-title">
        <div class="section-heading"><h2 id="education-title"><span class="heading-number">04 /</span> Education Background</h2></div>
        <ol class="education-list" aria-label="Education background">{% for entry in h.education %}<li class="education-card"><span class="education-level">{{ entry.degree | split: ' in ' | first | escape }}</span><h3>{{ entry.institution | escape }}</h3><p>{{ entry.degree | escape }}</p>{% if entry.note != '' %}<span class="degree-note">{{ entry.note | escape }}</span>{% endif %}</li>{% endfor %}</ol>
      </section>

      <section class="section contact-section" id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title"><span class="heading-number">05 /</span> Contact</h2><div class="contact-actions"><a class="primary-link email-link" href="mailto:{{ h.email | escape }}">{{ h.email | escape }} <span aria-hidden="true">↗</span></a><details class="wechat-contact">
          <summary class="primary-link">WeChat <span aria-hidden="true">↗</span></summary>
          <div class="wechat-card">
            <p class="wechat-id">JasonSunedu</p>
            <img src="{{ '/assets/img/wechat-qr.svg' | relative_url }}" width="245" height="245" alt="WeChat QR code for JasonSunedu" loading="lazy">
          </div>
        </details></div><div class="contact-links"><a href="{{ h.scholar | escape }}">Google Scholar</a><a href="{{ h.orcid | escape }}">ORCID</a><a href="{{ h.researchgate | escape }}">ResearchGate</a></div>
      </section>
    </main>
    <footer class="site-footer"><div class="footer-inner"><span>{{ h.name | escape }} · <span lang="zh-Hans">{{ h.chinese_name | escape }}</span></span><a href="#intro">Back to top ↑</a></div></footer>
  </body>
</html>
