---
layout: default
---
<div class="post about-page">
  <header class="home-intro">
  <div class="home-intro-text">
    <h1 class="home-name">
      {{ site.first_name }} {{ site.last_name }}
      <span class="home-name-chinese" lang="zh-Hans">孙稷威</span>
    </h1>

    <p class="home-position">
      {{ page.subtitle }}
    </p>

    <div class="home-summary">
      {{ page.hero_intro | markdownify }}
    </div>

    <nav class="home-links" aria-label="Profile links">
      <a href="{{ '/publications/' | relative_url }}">
        Publications
      </a>
      <a href="https://scholar.google.com/citations?user=8lP07gUAAAAJ">
        Google Scholar
      </a>
      <a href="mailto:yc47104@um.edu.mo">
        Email
      </a>
    </nav>
  </div>

  {% if page.profile.image %}
    <div class="home-portrait-frame">
      {% assign portrait_path = page.profile.image | prepend: 'assets/img/' %}
      {% include figure.liquid
        loading="eager"
        path=portrait_path
        class="home-portrait"
        sizes="(min-width: 768px) 300px, 70vw"
        alt="Portrait of Jiwei Sun"
        cache_bust=true
      %}
    </div>
  {% endif %}
</header>

  <div class="about-body">
    {{ content }}
  </div>

  <article>
    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
